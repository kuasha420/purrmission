# Database (Prisma SQLite, reused from root if desired)
DATABASE_URL="file:./data/dev.db"
# Production migration backup (use an independent key and separately mounted offsite path)
BACKUP_ENCRYPTION_KEYS_JSON='{"backup-local":"replace-with-an-independent-64-character-hex-key"}'
BACKUP_ACTIVE_KEY_ID='backup-local'
BACKUP_OFFSITE_DIR='/mnt/purrmission-offsite'
BACKUP_RETENTION_DAYS='30'
BACKUP_MIN_RECOVERY_COPIES='7'
BACKUP_MAX_AGE_MINUTES='30'
BACKUP_MAX_DATABASE_BYTES='268435456'

# Discord Bot Configuration
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_GUILD_ID="your-discord-guild-id"
DISCORD_ANNOUNCE_CHANNEL_ID="your-announcement-channel-id"

# HTTP Server Configuration
APP_PORT=3001
EXTERNAL_API_URL="http://localhost:3001"

# Optional MCP / AI tooling
CONTEXT7_API_KEY=""
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Encryption key for resource field values (required for /purrmission resource commands)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
AUDIT_INTEGRITY_KEY=""
AUDIT_INTEGRITY_KEY_ID="audit-v1"
# JSON object of prior key IDs to 32-byte hex keys; retain entries while signed audit rows exist.
AUDIT_INTEGRITY_KEYS_JSON="{}"
OUTBOX_INTEGRITY_KEY=""
OUTBOX_INTEGRITY_KEY_ID="outbox-v1"
# JSON object of prior key IDs to 32-byte hex keys; retain entries while outbox rows are pending.
OUTBOX_INTEGRITY_KEYS_JSON="{}"
AUDIT_RETENTION_DAYS="365"
AUDIT_CHECKPOINT_INTERVAL="1000"
