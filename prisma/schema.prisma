generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ResourceMode {
  ONE_OF_N
  // TODO: extend with other modes in future if needed (e.g. TWO_OF_N, MAJORITY, etc.)
}

enum GuardianRole {
  OWNER
  GUARDIAN
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
}

model Resource {
  id        String       @id @default(uuid())
  name      String
  mode      ResourceMode @default(ONE_OF_N)
  createdAt DateTime     @default(now())

  // Optional linked 2FA account (one-to-one)
  totpAccountId          String?      @unique
  totpAccount            TOTPAccount? @relation(fields: [totpAccountId], references: [id], onDelete: SetNull)
  totpDelegationEnvelope Json?
  version                String       @default(uuid())
  totpLinkVersion        String       @default(uuid())

  guardians            Guardian[]
  approvalRequests     ApprovalRequest[]
  fields               ResourceField[]
  callbackDestinations CallbackDestination[]

  // Backlink from Environment (one-to-one)
  environment Environment?
}

/// A text field attached to a resource (e.g., password, API key).
/// Values are encrypted at rest using AES-256-GCM.
model ResourceField {
  id         String   @id @default(uuid())
  resourceId String
  name       String
  value      String // Encrypted at rest
  version    String   @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, name])
  @@index([resourceId])
}

model Guardian {
  id            String       @id @default(uuid())
  resourceId    String
  discordUserId String
  role          GuardianRole @default(GUARDIAN)
  createdAt     DateTime     @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, discordUserId])
  @@index([resourceId])
  @@index([discordUserId])
}

model ApprovalRequest {
  id                 String                @id @default(uuid())
  resourceId         String
  projectId          String?
  environmentId      String?
  status             ApprovalRequestStatus @default(PENDING)
  context            Json? // Nullable legacy context
  requesterId        String                @default("legacy")
  requesterType      String                @default("DISCORD_USER")
  authKind           String                @default("DISCORD")
  authFamily         String                @default("DISCORD")
  audience           String                @default("purrmission-bot")
  action             String                @default("resource.view")
  targetType         String                @default("RESOURCE")
  targetId           String?
  targetKey          String?
  canonicalKeySet    Json?
  canonicalKeyDigest String?
  targetVersion      String                @default("legacy")
  policyVersion      String                @default("legacy")
  reason             String?
  constraints        String? // JSON serialized constraints
  callbackUrl        String? // nullable
  idempotencyKey     String?
  payloadDigest      String?
  deliveryState      String                @default("PENDING")
  createdAt          DateTime              @default(now())
  expiresAt          DateTime              @default(now())
  resolvedBy         String?
  resolvedByType     String?
  resolvedAt         DateTime?
  cancelledBy        String?
  cancelledAt        DateTime?
  discordMessageId   String?
  discordChannelId   String?

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([requesterId, idempotencyKey])
  @@index([resourceId])
  @@index([status])
  @@index([requesterId])
  @@index([expiresAt])
  @@index([canonicalKeyDigest])
  @@index([targetType, targetId])
}

model ApprovalGrant {
  id                 String    @id @default(uuid())
  requestId          String    @unique
  resourceId         String
  projectId          String?
  environmentId      String?
  requesterId        String
  requesterType      String
  authKind           String
  authFamily         String    @default("DISCORD")
  audience           String    @default("purrmission-bot")
  action             String
  targetType         String    @default("RESOURCE")
  targetId           String?
  targetKey          String?
  canonicalKeySet    Json?
  canonicalKeyDigest String?
  targetVersion      String
  policyVersion      String
  constraints        String?
  resolverId         String    @default("system")
  resolverType       String    @default("DISCORD_USER")
  resolverEvidence   Json?
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?
  revokedAt          DateTime?
  revokedReason      String?

  @@index([resourceId])
  @@index([requesterId])
  @@index([expiresAt])
  @@index([canonicalKeyDigest])
}

model TOTPAccount {
  id                 String   @id @default(uuid())
  ownerDiscordUserId String
  accountName        String
  /// TOTP secret - encrypted at rest using AES-256-GCM in the application layer
  secret             String
  issuer             String?
  backupKey          String?
  version            String   @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Backlink from Resource (one-to-one)
  linkedResource Resource?

  @@unique([ownerDiscordUserId, accountName])
  @@index([ownerDiscordUserId])
}

model TOTPLinkConsent {
  id                        String    @id @default(uuid())
  accountId                 String
  resourceId                String
  ownerDiscordUserId        String
  initiatingResourceOwnerId String
  accountVersion            String
  linkPolicyVersion         String
  delegationPolicy          Json
  expiresAt                 DateTime
  usedAt                    DateTime?
  createdAt                 DateTime  @default(now())

  @@index([accountId])
  @@index([resourceId])
}

model TOTPDelegationConsent {
  id                 String    @id @default(uuid())
  resourceId         String
  totpAccountId      String
  operation          String
  requesterId        String
  ownerDiscordUserId String
  authFamily         String
  audience           String
  accountVersion     String
  linkVersion        String
  maxGrantExpiresAt  DateTime
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([resourceId])
  @@index([totpAccountId])
}

model AuditLog {
  id               String   @id @default(uuid())
  schemaVersion    Int      @default(2)
  eventFamily      String
  eventType        String
  surface          String
  operation        String
  outcomeCode      String
  capability       String?
  decisionCode     String
  reasonCode       String
  targetType       String
  targetId         String?
  authoritySources Json
  actorType        String
  principalId      String
  actorId          String?
  authKind         String?
  resolverType     String?
  resolverId       String?
  resourceId       String?
  projectId        String?
  environmentId    String?
  requestId        String?
  grantId          String?
  correlationId    String?
  causationId      String?
  statusCode       Int?
  durationMs       Int?
  retentionClass   String   @default("SECURITY")
  integrityKeyId   String
  integrityHash    String
  payload          Json? // Redacted metadata and non-sensitive context
  createdAt        DateTime @default(now())

  @@index([resourceId])
  @@index([projectId])
  @@index([eventType])
  @@index([eventFamily])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@index([requestId])
  @@index([grantId])
  @@index([createdAt])
}

model AuditCheckpoint {
  id               String   @id
  previousDigest   String?
  eventDigest      String
  checkpointHash   String
  integrityKeyId   String
  eventCount       Int
  throughId        String
  throughCreatedAt DateTime
  createdAt        DateTime

  @@index([createdAt])
  @@index([throughCreatedAt])
}

model OutboxEvent {
  id             String    @id @default(uuid())
  schemaVersion  Int       @default(1)
  eventType      String
  resourceId     String?
  requestId      String?
  destinationId  String?
  recipientId    String?
  deliveryId     String?
  correlationId  String
  causationId    String?
  integrityKeyId String
  integrityHash  String
  payload        Json // Redacted routing context / notifications; never secret material
  status         String    @default("PENDING") // PENDING, DELIVERY_IN_PROGRESS, DELIVERED_PENDING_AUDIT, PROCESSED, FAILED
  attempts       Int       @default(0)
  lastErrorCode  String?
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  claimedBy      String?
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, claimExpiresAt])
  @@index([nextRetryAt])
  @@index([deliveryId])
  @@index([status])
  @@index([resourceId])
  @@index([requestId])
  @@index([correlationId])
  @@index([createdAt])
}

enum AuthSessionStatus {
  PENDING
  APPROVED
  EXPIRED
  DENIED
  CONSUMED
}

model AuthSession {
  id               String            @id @default(uuid())
  deviceCode       String            @unique
  userCode         String            @unique
  status           AuthSessionStatus // PENDING, APPROVED, EXPIRED, DENIED, CONSUMED
  userId           String? // Linked Discord User ID; retained after consumption
  approvalAttempts Int               @default(0)
  pollAttempts     Int               @default(0)
  approvedAt       DateTime?
  consumedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id            String   @id @default(uuid())
  name          String
  description   String?
  ownerId       String // Discord User ID
  policyVersion String   @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environments Environment[]
  members      ProjectMember[]

  @@index([ownerId])
}

model Environment {
  id        String   @id @default(uuid())
  name      String
  slug      String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Link to Resource for credentials
  resourceId String?   @unique
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([projectId, slug])
  @@index([projectId])
}

enum ProjectMemberRole {
  READER
  WRITER
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String // Discord User ID
  role      ProjectMemberRole @default(READER)
  addedBy   String // Discord User ID of who added them
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

enum CredentialType {
  RESOURCE_API_KEY
  PAWTHY_TOKEN
  SERVICE_CREDENTIAL
}

model Credential {
  id            String         @id @default(uuid())
  type          CredentialType
  subjectId     String
  name          String
  digest        String         @unique
  digestKeyId   String
  prefix        String
  scopes        String // Canonical JSON string array
  audience      String
  targetType    String
  targetId      String
  createdAt     DateTime       @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  lastUsedAt    DateTime?
  version       String         @default(uuid())

  @@index([subjectId, type])
  @@index([targetType, targetId])
  @@index([revokedAt])
  @@index([digest])
}

enum CallbackDestinationStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

model CallbackDestination {
  id                             String                    @id @default(uuid())
  resourceId                     String
  projectId                      String?
  name                           String?
  url                            String
  status                         CallbackDestinationStatus @default(PENDING_VERIFICATION)
  keyId                          String                    @default("default")
  encryptedSecret                String
  verificationToken              String?
  verificationChallengeExpiresAt DateTime?
  verifiedAt                     DateTime?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, status])
  @@index([projectId, status])
  @@index([resourceId])
}
